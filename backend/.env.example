# ── SentCrypto Backend — Variáveis de Ambiente ──────────────────────────────
# Copie este arquivo como .env e ajuste o que precisar.
# NUNCA versione o .env: ele guarda credenciais.
#
# Todos os valores abaixo são opcionais — o sistema funciona sem nenhum deles.

# ── Modelo de IA ────────────────────────────────────────────────────────────
# Padrão: modelo multilíngue de avaliações (1 a 5 estrelas).
# Ele NÃO é especializado em finanças e erra em textos de mercado.
# Alternativas recomendadas para o TCC:
#   ProsusAI/finbert                              (financeiro, inglês)
#   cardiffnlp/twitter-xlm-roberta-base-sentiment (multilíngue, tweets)
#   lucas-leme/FinBERT-PT-BR                      (financeiro, português)
# BERT_MODEL_NAME=nlptown/bert-base-multilingual-uncased-sentiment

# Defina como 0 para subir a API sem carregar o modelo (útil em testes).
# CARREGAR_BERT=1

# ── Coleta do X (Twitter) ───────────────────────────────────────────────────
# Opcional. Só é usado se a coleta por cookies e por syndication falharem.
# Requer plano Basic ou superior da API do X.
# TWITTER_BEARER_TOKEN=seu_token_aqui

# Tempo (em segundos) que os tweets ficam em cache, para evitar rate limit.
# X_CACHE_TTL=300

# ── Coleta do Reddit ────────────────────────────────────────────────────────
# RECOMENDADO. Sem estas credenciais a coleta usa os endpoints públicos, que
# o Reddit limita por IP e normalmente recusa com HTTP 403.
#
# Como obter (leva 2 minutos):
#   1. Acesse https://www.reddit.com/prefs/apps  (logado)
#   2. Clique em "are you a developer? create an app..."
#   3. Preencha:
#        name          sentcrypto-tcc
#        tipo          script          <- precisa ser este
#        redirect uri  http://localhost:8000
#   4. Clique em "create app"
#   5. O client_id é a sequência logo ABAIXO do nome do app
#      (canto superior esquerdo, sob "personal use script")
#      O client_secret é o campo "secret"
#
# REDDIT_CLIENT_ID=cole_o_client_id_aqui
# REDDIT_CLIENT_SECRET=cole_o_secret_aqui

# O Reddit bloqueia User-Agent genérico. Troque pelo seu usuário do Reddit.
# REDDIT_USER_AGENT=python:sentcrypto-tcc:1.0 (by /u/seu_usuario)

# ── Regras de classificação ─────────────────────────────────────────────────
# Variação (em fração) para o candle ser considerado de alta/baixa. 0.005 = 0,5%
# LIMIAR_VARIACAO_CANDLE=0.005

# Variação (em %) para o preço ser considerado "subiu"/"desceu" na correlação.
# LIMIAR_VARIACAO_PRECO_PCT=0.05

# Sentiment Score mínimo para a hora não ser classificada como neutra.
# LIMIAR_SENTIMENT_SCORE=0.1

# ── Índices de sentimento (escala 0 a 1) ────────────────────────────────────
# INDICE_NEGATIVO=0.2
# INDICE_NEUTRO=0.5
# INDICE_POSITIVO=0.8

# ── Rede e segurança ────────────────────────────────────────────────────────
# Origens autorizadas a chamar a API, separadas por vírgula.
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Token exigido no header X-Admin-Token pelas rotas administrativas.
# Se ficar vazio, /login/x fica SEM proteção — aceitável apenas em localhost.
# Defina obrigatoriamente se a API for exposta na rede.
# ADMIN_TOKEN=

# ── Banco de dados ──────────────────────────────────────────────────────────
# Por padrão usa o SQLite em backend/dados.db.
# DATABASE_URL=sqlite:///./dados.db

# ── Moedas ──────────────────────────────────────────────────────────────────
# MOEDAS_SUPORTADAS=BTC,ETH,SOL,DOGE,XRP,ADA,AVAX,LINK
